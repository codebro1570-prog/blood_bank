# ========================================================
# Blood Bank Backend — Environment Variables (Railway / Cloud)
# ========================================================

# Server Port (Railway automatically sets PORT, defaults to 8080)
PORT=8080
SERVER_PORT=8080

# --------------------------------------------------------
# MySQL Database Configuration
# --------------------------------------------------------
# Option 1: If using Railway MySQL plugin, Railway provides these automatically:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLDATABASE=
# MYSQLUSER=
# MYSQLPASSWORD=

# Option 2: Full JDBC connection URL
DB_URL=jdbc:mysql://localhost:3306/bloodbank?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=bloodbank
DB_PASSWORD=bloodbank

# --------------------------------------------------------
# Redis Distributed Cache & Idempotency
# --------------------------------------------------------
REDIS_ENABLED=true
# If using Railway Redis plugin, Railway provides REDISHOST, REDISPORT, REDISPASSWORD:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------
# JWT Security (Must be at least 32 characters in production)
# --------------------------------------------------------
JWT_SECRET=c3VwZXJzZWNyZXRqd3RrZXlmaXJzdGltZTEyMzQ1Njc4OTAxMjM0NTY=

# --------------------------------------------------------
# Apache Kafka (Optional, default is false)
# --------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=bloodbank-domain-events
KAFKA_GROUP_ID=bloodbank-consumer-group
